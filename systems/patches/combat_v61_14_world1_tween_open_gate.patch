+        -- V61.14: World1 transition movement is tween/floating movement,
+        -- never Roblox Humanoid walking. Keep the same exact gate geometry
+        -- and evidence checks; only replace the movement driver.
+        local Motion = nil
+
+        if type(getgenv().IronSoulLoadRaw)
+            == "function"
+        then
+            local okMotion,
+                value =
+                    getgenv().IronSoulLoadRaw(
+                        "systems/world1_motion.lua"
+                    )
+
+            if okMotion
+                and type(value)
+                    == "table"
+            then
+                Motion = value
+            end
+        end
+
+        local travelY =
+            Root.Position.Y
+
+        local tweenDestination =
+            Vector3.new(
+                destination.X,
+                travelY,
+                destination.Z
+            )
+
+        if Motion
+            and type(Motion.MoveToPosition)
+                == "function"
+        then
+            Motion.MoveToPosition(
+                Root,
+                tweenDestination,
+                Vector3.new(
+                    doorPos.X,
+                    travelY,
+                    doorPos.Z
+                ),
+                {
+                    Speed = 210,
+                    MaxTime = 0.32,
+                }
+            )
+        else
+            -- Fail closed to an exact CFrame move, never Humanoid:MoveTo.
+            Root.CFrame =
+                CFrame.lookAt(
+                    tweenDestination,
+                    Vector3.new(
+                        doorPos.X,
+                        travelY,
+                        doorPos.Z
+                    )
+                )
+        end
+
+        local started =
+            os.clock()
+
+        while os.clock()
+            - started
