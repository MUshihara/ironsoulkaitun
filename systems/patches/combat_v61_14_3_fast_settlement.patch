+-- Fast 24/7 maintenance exit. Keep all temporary values in a nested scope so
+-- this already-large top-level chunk does not retain extra Luau registers.
+do
+    local fastBagFull,
+        fastBagReason =
+            dungeonBagFullStatus()
+
+    local fastInventory =
+        inventoryCountNow()
+
+    if fastBagFull
+        or fastInventory
+            >= INVENTORY_CLEAN_AT
+    then
+        important(
+            "Maintenance | immediate Lobby | "
+                .. tostring(
+                    fastBagFull
+                    and fastBagReason
+                    or "INVENTORY_HIGH"
+                )
+        )
+
+        writeJournal({
+            State = "FAST_MAINTENANCE",
+            Decision = "LOBBY_MAINTENANCE",
+            World = journal.World or "?",
+            Diff = journal.Diff or "?",
+            DirectRepeats = 0,
+            FailureCount = journal.FailureCount or 0,
+            UpdatedAt = os.time(),
+        })
+
+        directLobby(
+            fastBagFull
+            and ("BAG_FULL_" .. tostring(fastBagReason))
+            or "INVENTORY_HIGH"
+        )
+
+        return
+    end
+end
