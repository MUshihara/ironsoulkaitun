+-- Fast 24/7 maintenance exit. If the account already knows the bag is full
+-- or equipment inventory has reached the cleanup threshold, do not wait for
+-- settlement replay UI and do not attempt Play Again at all.
+local immediateBagFull,
+    immediateBagReason,
+    immediateOreUsed,
+    immediateOreMax =
+        dungeonBagFullStatus()
+
+local immediateInventory =
+    inventoryCountNow()
+
+if immediateBagFull
+    or immediateInventory
+        >= INVENTORY_CLEAN_AT
+then
+    important(
+        "Maintenance | immediate Lobby | "
+            .. tostring(
+                immediateBagFull
+                and immediateBagReason
+                or "INVENTORY_HIGH"
+            )
+    )
+
+    writeJournal({
+        State = "FAST_MAINTENANCE",
+        Decision = "LOBBY_MAINTENANCE",
+        World = journal.World or "?",
+        Diff = journal.Diff or "?",
+        DirectRepeats = 0,
+        FailureCount = journal.FailureCount or 0,
+        UpdatedAt = os.time(),
+    })
+
+    directLobby(
+        immediateBagFull
+        and ("BAG_FULL_" .. tostring(immediateBagReason))
+        or "INVENTORY_HIGH"
+    )
+
+    return
+end
+
