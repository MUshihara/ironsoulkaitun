+--========================================================--
+-- V61.9 UNKNOWN OBJECTIVE RESOLVER
+--
+-- New worlds can put a destroyable wall/gate/barrier between ordinary
+-- RoundDoor phases. The normal enemy list intentionally does not include
+-- those objects. Load a bounded evidence-driven resolver that can discover
+-- them without hardcoding a world, round, object path, or coordinate.
+--========================================================--
+
+getgenv().IronSoulObjectiveResolver =
+    nil
+
+do
+    local loadRaw =
+        getgenv().IronSoulLoadRaw
+
+    if type(loadRaw) == "function" then
+        local ok, factory =
+            loadRaw(
+                "systems/objective_probe.lua"
+            )
+
+        if ok
+            and type(factory) == "function"
+        then
+            local builtOk, built =
+                pcall(
+                    factory,
+                    {
+                        LocalPlayer = LocalPlayer,
+
+                        getRoot = function()
+                            return Root
+                        end,
+
+                        getCurrentRegion = function()
+                            return CurrentCombatRegion
+                        end,
+
+                        gameRound = gameRound,
+                        settlementDetected = settlementDetected,
+                        fullName = fullName,
+                        sendHeadlessAttack = sendHeadlessAttack,
+                        skillReady = skillReady,
+                        castSkill = castSkill,
+
+                        hasNormalObjective = function()
+                            return #liveEnemies() > 0
+                                or currentDragonEgg() ~= nil
+                        end,
+
+                        event = function(name, detail)
+                            local telemetry =
+                                getgenv().IronSoulTelemetry
+
+                            if telemetry then
+                                telemetry:Event(name, detail)
+                            end
+
+                            getgenv().IronSoulNavTrace(
+                                tostring(name)
+                                    .. " "
+                                    .. tostring(detail or "")
+                            )
+                        end,
+                    }
+                )
+
+            if builtOk
+                and type(built) == "table"
+            then
+                getgenv().IronSoulObjectiveResolver =
+                    built
+            else
+                important(
+                    "Objective resolver init failed"
+                )
+            end
+        else
+            important(
+                "Objective resolver load failed"
+            )
+        end
+    end
+end
